```gitignore
# Compiled and build artifacts
*.obj
*.exe
*.dll
*.pdb
*.userprefs
*.cache
bin/
obj/
Debug/
Release/

# Dependencies
packages/
node_modules/
.nuget/
.nuget.packages/

# Logs and temp files
*.log
*.tmp
*.temp

# Environment
.env
.env.local
*.env.*

# Editors
.vs/
.vshost/
.user
.userosscache
.suo
.ReSharper*/
_UpgradeReport_Files/

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
Icon?
```