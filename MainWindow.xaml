<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Система управления арендой недвижимости" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#E8F4F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C5F7F" Padding="0,15">
            <StackPanel Margin="20,0">
                <WrapPanel HorizontalAlignment="Center">
                    <Image Source="/resources/logo.png" Width="70" Height="60" Margin="10"/>
                    <TextBlock Text="АРЕНДА-УПРАВЛЕНИЕ" FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <Button x:Name="BtnHome" Content="🏠 Главная" Click="MenuItem_Home_Click" Style="{StaticResource TabButtonStyle}" Margin="0,0,10,0" Padding="15,10"/>
                    <Button x:Name="BtnProperties" Content="🏢 Объекты" Click="MenuItem_Properties_Click" Style="{StaticResource TabButtonStyle}" Padding="15,10"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Main content area -->
        <Border Grid.Row="1" Margin="15" Background="#E8F4F8">
            <ContentControl x:Name="MainContent"/>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Background="#2C5F7F" VerticalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                <TextBlock Text="✅ Готов к работе" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="14"/>
                <Button Content="🚪 Выход" Click="BtnExit_Click" Width="100" Height="35" Margin="0,0,10,0" Background="#CD5C5C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
