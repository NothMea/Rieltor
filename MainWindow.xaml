<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Система управления арендой недвижимости" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#f38c77">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="40"/>

        </Grid.RowDefinitions>


        <Border Grid.Row="0" Background="#A55233">

            <StackPanel Margin="20,0">
                <WrapPanel HorizontalAlignment="Center">
                    <Image Source="/resources/logo.png" Width="60" Height="50" Margin="10"/>
                    <TextBlock Text="АРЕНДА-УПРАВЛЕНИЕ" FontSize="24" FontWeight="Bold" Foreground="Black" Width="300" Height="30"/>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnHome" Content="Главная" Click="MenuItem_Home_Click" Style="{StaticResource TabButtonStyle}" Margin="0,0,5,0"/>
                    <Button x:Name="BtnProperties" Content="Объекты" Click="MenuItem_Properties_Click" Style="{StaticResource TabButtonStyle}" Margin="0,0,5,0"/>
                </StackPanel>
            </StackPanel>
        </Border>


        <Border Grid.Row="1" Margin="15" Background="#f38c77">
            <ContentControl x:Name="MainContent"/>
        </Border>


        <Grid Grid.Row="2" Background="#A55233" VerticalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                <TextBlock Text="Готов к работе" Foreground="Black" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Button Content="Выход" Click="BtnExit_Click" Width="80" Height="30" Margin="0,0,10,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
