<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Система управления арендой недвижимости" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#E8F4F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C5F7F">
            <StackPanel Margin="20,10">
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="RIELTOR" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Image Source="/resources/logo.png" Width="60" Height="50" Margin="10,10,10,5"/>
                    <TextBlock Text="АРЕНДА-УПРАВЛЕНИЕ" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                    <Button x:Name="BtnHome" Content="Главная" Click="MenuItem_Home_Click" Style="{StaticResource TabButtonStyle}"/>
                    <Button x:Name="BtnProperties" Content="Объекты" Click="MenuItem_Properties_Click" Style="{StaticResource TabButtonStyle}"/>
                    <Button x:Name="BtnTenants" Content="Арендаторы" Click="MenuItem_Tenants_Click" Style="{StaticResource TabButtonStyle}"/>
                    <Button x:Name="BtnHistory" Content="История договоров" Click="MenuItem_History_Click" Style="{StaticResource TabButtonStyle}"/>
                    <Button x:Name="BtnPayments" Content="Платежи" Click="MenuItem_Payments_Click" Style="{StaticResource TabButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="15" Background="#E8F4F8">
            <ContentControl x:Name="MainContent"/>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="2" Background="#2C5F7F">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                <Button Content="Выход" Click="BtnExit_Click" Width="80" Height="35" Margin="0,0,10,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
