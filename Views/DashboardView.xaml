<UserControl x:Class="WpfApp1.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel Margin="15">
            <TextBlock Text="Панель управляющего" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C5F7F"/>

            <!-- Статистика -->
            <Grid Margin="0,0,0,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#E3F2FD" CornerRadius="8" Padding="15" Margin="0,0,10,0" BorderBrush="#90CAF9" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Всего объектов" Foreground="#1565C0" FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtTotalProperties" Text="0" FontSize="28" FontWeight="Bold" Foreground="#0D47A1"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#E8F5E9" CornerRadius="8" Padding="15" Margin="5,0" BorderBrush="#A5D6A7" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Активных договоров" Foreground="#2E7D32" FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtActiveLeases" Text="0" FontSize="28" FontWeight="Bold" Foreground="#1B5E20"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#FFEBEE" CornerRadius="8" Padding="15" Margin="10,0,0,0" BorderBrush="#EF9A9A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Просроченных платежей" Foreground="#C62828" FontSize="14" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtOverduePayments" Text="0" FontSize="28" FontWeight="Bold" Foreground="#B71C1C"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Предупреждения -->
            <TextBlock Text="Текущие уведомления" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#2C5F7F"/>
            <ItemsControl x:Name="WarningsList" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFF8E1" BorderBrush="#FFD54F" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#5D4037"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Ближайшие события -->
            <TextBlock Text="Ближайшие события" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#2C5F7F"/>
            <ItemsControl x:Name="UpcomingEvents">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="📅 " FontSize="16"/>
                            <TextBlock Text="{Binding}" FontSize="14" Foreground="#333333"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
