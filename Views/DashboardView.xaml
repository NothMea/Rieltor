<UserControl x:Class="WpfApp1.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel>
            <TextBlock Text="Панель управляющего" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- Статистика -->
            <Grid Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#E6F7FF" CornerRadius="10" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Всего объектов" Foreground="#007ACC" FontSize="14"/>
                        <TextBlock x:Name="TxtTotalProperties" Text="0" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#F0FFF0" CornerRadius="10" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Активных договоров" Foreground="#2E8B57" FontSize="14"/>
                        <TextBlock x:Name="TxtActiveLeases" Text="0" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#FFF5F5" CornerRadius="10" Padding="15" Margin="5">
                    <StackPanel>
                        <TextBlock Text="Просроченных платежей" Foreground="#CD5C5C" FontSize="14"/>
                        <TextBlock x:Name="TxtOverduePayments" Text="0" FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Предупреждения -->
            <TextBlock Text="Текущие уведомления" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ItemsControl x:Name="WarningsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FFF8E1" BorderBrush="#FFD54F" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Ближайшие события -->
            <TextBlock Text="Ближайшие события" FontSize="18" FontWeight="SemiBold" Margin="0,30,0,10"/>
            <ItemsControl x:Name="UpcomingEvents">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="📅 " FontSize="16"/>
                            <TextBlock Text="{Binding}" FontSize="14"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
