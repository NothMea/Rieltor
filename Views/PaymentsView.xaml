<UserControl x:Class="WpfApp1.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="15">
            <Button Content="Добавить платёж" Click="BtnAddPayment_Click" Width="180" Style="{StaticResource TabButtonStyle}"/>
            <Button Content="Обновить" Click="BtnRefresh_Click" Width="120" Margin="10,0,0,0" Style="{StaticResource TabButtonStyle}"/>
        </StackPanel>

        <!-- Панель фильтров -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="15,0,15,15">
            <TextBlock Text="Фильтр по статусу:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <ComboBox x:Name="CmbFilterStatus" Width="150" SelectionChanged="CmbFilterStatus_SelectionChanged" Margin="0,0,15,0">
                <ComboBoxItem Content="Все статусы"/>
                <ComboBoxItem Content="Оплачен"/>
                <ComboBoxItem Content="Просрочен"/>
                <ComboBoxItem Content="Ожидает"/>
            </ComboBox>
            
            <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
            <DatePicker x:Name="DpFromDate" Width="120" SelectedDateChanged="DpFromDate_SelectedDateChanged" Margin="0,0,5,0"/>
            <TextBlock Text="-" VerticalAlignment="Center" Margin="5,0,5,0"/>
            <DatePicker x:Name="DpToDate" Width="120" SelectedDateChanged="DpToDate_SelectedDateChanged"/>
        </StackPanel>

        <!-- Таблица платежей -->
        <Border Grid.Row="2" Margin="15,0,15,15" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8">
            <DataGrid x:Name="PaymentsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" 
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="40"
                      AlternatingRowBackground="#F5F5F5" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="№" Binding="{Binding PaymentID}" Width="50"/>
                    <DataGridTextColumn Header="Договор №" Binding="{Binding LeaseNumber}" Width="100"/>
                    <DataGridTextColumn Header="Дата платежа" Binding="{Binding PaymentDate, StringFormat=dd.MM.yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Сумма (₽)" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
                    <DataGridTemplateColumn Header="Статус" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Оплачен">
                                                    <Setter Property="Foreground" Value="Green"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Просрочен">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Ожидает">
                                                    <Setter Property="Foreground" Value="Orange"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Адрес объекта" Binding="{Binding Address}" Width="200"/>
                    <DataGridTextColumn Header="Арендатор" Binding="{Binding TenantName}" Width="150"/>
                    <DataGridTemplateColumn Header="Действия" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="✏️" Click="EditPayment_Click" ToolTip="Редактировать" 
                                            Width="35" Margin="2,0" Padding="5,2"/>
                                    <Button Content="🗑️" Click="DeletePayment_Click" ToolTip="Удалить" 
                                            Width="35" Margin="2,0" Padding="5,2" Background="#CD5C5C"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
