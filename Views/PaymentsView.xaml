<UserControl x:Class="WpfApp1.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и статистика -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Управление платежами" FontSize="24" FontWeight="Bold" Margin="0,0,0,15" Foreground="#2C5F7F"/>
            
            <!-- Карточки статистики -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Всего платежей -->
                <Border Grid.Column="0" Background="#E3F2FD" CornerRadius="10" Padding="15" Margin="0,0,8,0" BorderBrush="#90CAF9" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📊 Всего платежей" Foreground="#1565C0" FontSize="13" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtTotalPayments" Text="0" FontSize="26" FontWeight="Bold" Foreground="#0D47A1" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Оплачено -->
                <Border Grid.Column="1" Background="#E8F5E9" CornerRadius="10" Padding="15" Margin="4,0" BorderBrush="#A5D6A7" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="✅ Оплачено" Foreground="#2E7D32" FontSize="13" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtPaidAmount" Text="0 ₽" FontSize="26" FontWeight="Bold" Foreground="#1B5E20" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Ожидает -->
                <Border Grid.Column="2" Background="#FFF3E0" CornerRadius="10" Padding="15" Margin="4,0" BorderBrush="#FFCC80" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⏳ Ожидает оплаты" Foreground="#EF6C00" FontSize="13" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtPendingAmount" Text="0 ₽" FontSize="26" FontWeight="Bold" Foreground="#E65100" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Просрочено -->
                <Border Grid.Column="3" Background="#FFEBEE" CornerRadius="10" Padding="15" Margin="8,0,0,0" BorderBrush="#EF9A9A" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⚠️ Просрочено" Foreground="#C62828" FontSize="13" FontWeight="Bold"/>
                        <TextBlock x:Name="TxtOverdueAmount" Text="0 ₽" FontSize="26" FontWeight="Bold" Foreground="#B71C1C" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Панель инструментов -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Кнопка добавить -->
                <Button Grid.Column="0" Content="➕ Добавить платеж" Click="BtnAddPayment_Click" Width="180" Style="{StaticResource TabButtonStyle}"/>

                <!-- Фильтр по статусу -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Статус:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CmbStatusFilter" Width="150" SelectionChanged="CmbStatusFilter_SelectionChanged">
                        <ComboBoxItem Content="Все статусы"/>
                        <ComboBoxItem Content="Ожидает"/>
                        <ComboBoxItem Content="Оплачен"/>
                        <ComboBoxItem Content="Просрочен"/>
                    </ComboBox>
                </StackPanel>

                <!-- Фильтр по дате -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Период:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <DatePicker x:Name="DpFromDate" Width="120" SelectedDateChanged="DateFilter_Changed"/>
                    <TextBlock Text="-" VerticalAlignment="Center" Margin="5,0"/>
                    <DatePicker x:Name="DpToDate" Width="120" SelectedDateChanged="DateFilter_Changed"/>
                </StackPanel>

                <!-- Поиск -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBox x:Name="TxtSearch" Width="200" TextChanged="TxtSearch_TextChanged">
                        <TextBox.Text>
                            <Binding Path="SearchText" UpdateSourceTrigger="PropertyChanged"/>
                        </TextBox.Text>
                    </TextBox>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="16"/>
                </StackPanel>

                <!-- Кнопка сброса фильтров -->
                <Button Grid.Column="5" Content="🔄 Сбросить фильтры" Click="BtnResetFilters_Click" Margin="10,0,0,0" Width="140"/>

                <!-- Экспорт -->
                <Button Grid.Column="5" Content="📥 Экспорт CSV" Click="BtnExportCSV_Click" Margin="10,0,0,0" Width="120" Background="#4CAF50"/>
            </Grid>
        </Border>

        <!-- Таблица платежей -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1">
            <DataGrid x:Name="PaymentsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                      RowHeight="55" AlternatingRowBackground="#F5F5F5" SelectionMode="Single">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2C5F7F"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding PaymentID}" Width="60" ElementStyle="{StaticResource CenterTextStyle}"/>
                    
                    <DataGridTemplateColumn Header="Дата платежа" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PaymentDate, StringFormat=dd.MM.yyyy}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Договор №" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Leases.LeaseNumber}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Арендатор" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Leases.Tenants.Name}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Объект" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Leases.Property.Address}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Сумма (₽)" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Amount, StringFormat=N0}" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Статус" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="8,4" HorizontalAlignment="Center"
                                        Background="{Binding Status, Converter={StaticResource StatusColorConverter}, ConverterParameter=Background}">
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Примечание" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Действия" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏️" ToolTip="Редактировать" Click="EditPaymentButton_Click" 
                                            Width="32" Height="32" Margin="2,0" Tag="{Binding}" 
                                            Style="{StaticResource SmallButtonStyle}"/>
                                    <Button Content="💰" ToolTip="Отметить как оплаченный" Click="MarkAsPaidButton_Click" 
                                            Width="32" Height="32" Margin="2,0" Tag="{Binding}" 
                                            Style="{StaticResource SmallButtonStyle}"
                                            Visibility="{Binding Status, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=NotPaid}"/>
                                    <Button Content="🗑️" ToolTip="Удалить" Click="DeletePaymentButton_Click" 
                                            Width="32" Height="32" Margin="2,0" Tag="{Binding}" 
                                            Style="{StaticResource SmallButtonStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
