<UserControl x:Class="WpfApp1.Views.PropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#F5F5F5">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15" Effect="{StaticResource ShadowEffect}">
            <StackPanel Orientation="Horizontal">
                <Button Content="Обновить" Click="BtnRefresh_Click" Width="110" Height="35" Margin="0,0,10,0" 
                        Style="{StaticResource PrimaryButtonStyle}" Cursor="Hand"/>
                <Button Content="Добавить объект" Click="BtnAdd_Click" Width="130" Height="35" 
                        Style="{StaticResource SuccessButtonStyle}" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Карточки объектов -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ItemsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" 
                                CornerRadius="12" Margin="0,0,15,15" Padding="0" 
                                Width="380" SnapsToDevicePixels="True"
                                Effect="{StaticResource ShadowEffect}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Заголовок карточки -->
                                <Border Grid.Row="0" Background="#4A90D9" CornerRadius="12,12,0,0" Padding="15,12">
                                    <TextBlock Text="{Binding Address}" FontSize="15" FontWeight="SemiBold" 
                                               Foreground="White" TextWrapping="Wrap" MaxWidth="340"/>
                                </Border>

                                <!-- Основная информация -->
                                <StackPanel Grid.Row="1" Margin="15,15,15,10">
                                    <StackPanel Margin="0,0,0,12">
                                        <TextBlock Text="Тип объекта" FontSize="11" Foreground="#757575" Margin="0,0,0,3"/>
                                        <TextBlock Text="{Binding PropertyType}" FontSize="14" FontWeight="Medium" 
                                                   Foreground="#333333"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Площадь" FontSize="11" Foreground="#757575" Margin="0,0,0,3"/>
                                            <TextBlock FontSize="14" FontWeight="Medium" Foreground="#333333">
                                                <Run Text="{Binding Area}"/><Run Text=" м²"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Стоимость" FontSize="11" Foreground="#757575" Margin="0,0,0,3"/>
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#4A90D9">
                                                <Run Text="{Binding MonthlyRent, StringFormat={}{0:N0}}"/><Run Text=" ₽"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Информация об активном договоре -->
                                    <Border x:Name="ActiveLeasePanel" Visibility="{Binding HasActiveLease, Converter={StaticResource BoolToVisibilityConverter}}" 
                                            Background="#F8F9FA" BorderBrush="#E8F4FD" BorderThickness="1" 
                                            Padding="12" Margin="0,5,0,5" CornerRadius="8">
                                        <StackPanel>
                                            <TextBlock Text="Активный договор" FontSize="12" FontWeight="SemiBold" 
                                                       Foreground="#2E7D32" Margin="0,0,0,8"/>
                                            
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock FontSize="11" Foreground="#757575" Margin="0,0,0,2">
                                                    <Run Text="№ "/><Run Text="{Binding ActiveLease.LeaseNumber}" FontWeight="Medium"/>
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="#757575">
                                                    <Run Text="{Binding ActiveLease.StartDate, StringFormat=dd.MM.yyyy}"/>
                                                    <Run Text=" — " Foreground="#BDBDBD"/>
                                                    <Run Text="{Binding ActiveLease.EndDate, StringFormat=dd.MM.yyyy}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Border Background="#FFF3CD" Padding="6,4" CornerRadius="4" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding ActiveLease.PaymentStatus, StringFormat=Статус: {0}}" 
                                                           FontSize="11" FontWeight="Medium" Foreground="#856404"/>
                                            </Border>

                                            <Button Content="Редактировать договор" Click="EditLeaseButton_Click" 
                                                    HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,6" 
                                                    Width="160" Height="32" Cursor="Hand"
                                                    Style="{StaticResource SecondaryButtonStyle}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Нет активного договора -->
                                    <Border x:Name="NoLeaseText" Visibility="{Binding HasActiveLease, Converter={StaticResource InverseBoolToVisibilityConverter}}" 
                                            Background="#FFEBEE" BorderBrush="#FFCDD2" BorderThickness="1"
                                            Padding="12,8" CornerRadius="8" Margin="0,5,0,0">
                                        <TextBlock Text="Нет активных договоров" FontSize="12" FontWeight="Medium" 
                                                   Foreground="#C62828" HorizontalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <!-- Кнопки управления -->
                                <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" 
                                        Padding="15,12" CornerRadius="0,0,12,12">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Редактировать" Click="EditPropertyButton_Click" 
                                                Width="140" Height="34" Margin="0,0,8,0" Cursor="Hand"
                                                Style="{StaticResource PrimaryButtonStyle}"/>
                                        <Button Content="Арендаторы" Click="ViewTenantsButton_Click" 
                                                Width="140" Height="34" Cursor="Hand"
                                                Style="{StaticResource InfoButtonStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
