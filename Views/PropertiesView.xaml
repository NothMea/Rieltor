<UserControl x:Class="WpfApp1.Views.PropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp1.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <StackPanel Orientation="Horizontal" Margin="10">
            <Button Content="Обновить" Click="BtnRefresh_Click" Width="100" Margin="0,0,10,0"/>
            <Button Content="Добавить объект" Click="BtnAdd_Click" Width="120" Margin="0,0,10,0"/>
            <Button Content="Добавить договор" Click="BtnAddLease_Click" Width="120"/>
        </StackPanel>

        <!-- Карточки объектов -->
        <ScrollViewer Grid.Row="1" Margin="10">
            <ItemsControl x:Name="ItemsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="10" Margin="10" Padding="15" Width="538" Height="250">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Изображение объекта -->
                                <Image Grid.Column="0" Width="100" Height="100" Stretch="UniformToFill" Margin="0,0,10,0" VerticalAlignment="Top">
                                    <Image.Source>
                                        <Binding Path="ImagePath">
                                            <Binding.TargetNullValue>
                                                <BitmapImage UriSource="/Resources/logo.png"/>
                                            </Binding.TargetNullValue>
                                            <Binding.FallbackValue>
                                                <BitmapImage UriSource="/Resources/logo.png"/>
                                            </Binding.FallbackValue>
                                        </Binding>
                                    </Image.Source>
                                </Image>

                                <!-- Информация об объекте -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Address}" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding PropertyType}" FontStyle="Italic" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Area, StringFormat=Площадь: {0} м²}" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding MonthlyRent, StringFormat=Стоимость: {0}  ₽/мес}" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                    <Border x:Name="ActiveLeasePanel" Visibility="{Binding HasActiveLease, Converter={StaticResource BoolToVisibilityConverter}}" Background="#F0F0F0" Padding="8" Margin="0,5,0,5" CornerRadius="5">
                                        <StackPanel>
                                            <TextBlock Text="Активный договор:" FontWeight="Bold" Margin="0,0,0,5"/>
                                            <TextBlock Text="{Binding ActiveLease.LeaseNumber, StringFormat=№ {0}}" Margin="0,0,0,3"/>
                                            <TextBlock>
                                                <Run Text="С "/>
                                                <Run Text="{Binding ActiveLease.StartDate, StringFormat=dd.MM.yyyy}"/>
                                                <Run Text=" по "/>
                                                <Run Text="{Binding ActiveLease.EndDate, StringFormat=dd.MM.yyyy}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ActiveLease.PaymentStatus, StringFormat=Статус: {0}}" FontWeight="SemiBold"/>
                                            <!-- Кнопка редактирования договора -->
                                            <Button Content="Редактировать договор" Click="EditLeaseButton_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,5"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="NoLeaseText" Text="❌ Нет активных договоров" Foreground="Red" FontWeight="Bold" Visibility="{Binding HasActiveLease, Converter={StaticResource InverseBoolToVisibilityConverter}}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>